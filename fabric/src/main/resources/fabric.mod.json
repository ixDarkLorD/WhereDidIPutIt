{
  "schemaVersion": 1,
  "id": "${modid}",
  "version": "${mc_version}-${mod_version}",

  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [
    "${mod_author}"
  ],
  "contact": {
    "homepage": "${mod_page_url}",
    "issues": "${mod_issue_url}",
    "sources": "${mod_source_url}"
  },

  "license": "${mod_license}",
  "icon": "mod_logo.png",

  "environment": "${mod_environment}",
  "entrypoints": {
    "coolcatlib:common": [
      "net.ixdarklord.wheredidiputit.WhereDidIPutIt",
      "net.ixdarklord.wheredidiputit.fabric.WhereDidIPutItFabricCommon"
    ],
    "coolcatlib:client": [
      "net.ixdarklord.wheredidiputit.WhereDidIPutItClient",
      "net.ixdarklord.wheredidiputit.fabric.WhereDidIPutItFabricClient"
    ],
    "jei_mod_plugin": [
      "net.ixdarklord.wheredidiputit.compat.jei.WDIPIJeiPlugin"
    ]
  },
  "mixins": [
    "${modid}.common.mixins.json"
  ],

  "custom": {
    "glazedmenu": {
      "update_json": "${mod_fabric_update_url}"
    }
  },

  "depends": {
    "java": ">=${versions.java.get()}",
    "minecraft": ">=${mc_version} <=${max_mc_version}",
    "fabricloader": ">=${min_fabric_version}",
    "fabric-api": ">=${min_fabric_api_version}",
    "coolcatlib": ">=${coolcatlib_version}"
  }
}
